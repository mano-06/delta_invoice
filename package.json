{
  "name": "delta-inv",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "electron-builder",
    "package": "npm run electron:build"
  },
  "dependencies": {
    "better-sqlite3": "8.4.0",
    "dayjs": "^1.11.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.16.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^26.2.2",
    "electron-builder": "^24.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.4",
    "vite": "^5.4.1",
    "wait-on": "^7.0.3"
  },
  "build": {
    "appId": "com.delta.invoice",
    "productName": "Delta Invoice",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "sign": "./scripts/disable-signing.js",
      "signAndEditExecutable": false
    }
  }
}
